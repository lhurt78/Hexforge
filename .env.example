# =========================
# HEXFORGE CORE SETTINGS
# =========================

HEXFORGE_NAME=Hexforge
HEXFORGE_VERSION=0.1.0
HEXFORGE_ENV=development

# =========================
# PATHS
# =========================

KNOWLEDGE_PATH=05_KNOWLEDGE
MEMORY_PATH=06_PROJECT_MEMORY
OUTPUT_PATH=08_OUTPUTS
BACKUP_PATH=09_BACKUPS

# =========================
# MODEL SETTINGS
# =========================

DEFAULT_MODEL_PROVIDER=local
DEFAULT_MODEL_NAME=phi-3-mini

# =========================
# LOGGING
# =========================

LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=true

# =========================
# SAFETY
# =========================

ALLOW_WEB_ACCESS=false
ALLOW_SELF_MODIFICATION=false
ALLOW_AUTONOMOUS_ACTIONS=false